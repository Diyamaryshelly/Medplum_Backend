# Development Dockerfile with hot reload support
# This Dockerfile is optimized for development with volume mounting
# Only the server source code will be mounted as a volume for hot reload

FROM node:22-alpine

# Install necessary build tools and curl for healthcheck
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev \
    curl

# Set working directory
WORKDIR /app

# Copy root configuration files
COPY package*.json ./
COPY turbo.json ./
COPY tsconfig.json ./
COPY api-extractor.json ./
COPY tsdoc.json ./

# Copy package.json and tsconfig.json for ALL workspace packages
COPY packages/fhirtypes/package.json     ./packages/fhirtypes/
COPY packages/fhirtypes/tsconfig*.json   ./packages/fhirtypes/
COPY packages/definitions/package.json   ./packages/definitions/
COPY packages/definitions/tsconfig*.json ./packages/definitions/
COPY packages/hl7/package.json           ./packages/hl7/
COPY packages/hl7/tsconfig*.json         ./packages/hl7/
COPY packages/core/package.json          ./packages/core/
COPY packages/core/tsconfig*.json        ./packages/core/
COPY packages/fhir-router/package.json   ./packages/fhir-router/
COPY packages/fhir-router/tsconfig*.json ./packages/fhir-router/
COPY packages/bot-layer/package.json     ./packages/bot-layer/
COPY packages/bot-layer/tsconfig*.json   ./packages/bot-layer/
COPY packages/ccda/package.json          ./packages/ccda/
COPY packages/ccda/tsconfig*.json        ./packages/ccda/
COPY packages/mock/package.json          ./packages/mock/
COPY packages/mock/tsconfig*.json        ./packages/mock/
COPY packages/server/package.json        ./packages/server/
COPY packages/server/tsconfig*.json      ./packages/server/

# Install ALL dependencies (including dev dependencies for tsx)
RUN npm ci

# Copy source code for all packages EXCEPT server
# Server source will be mounted as a volume
COPY packages/fhirtypes/          ./packages/fhirtypes/
COPY packages/definitions/        ./packages/definitions/
COPY packages/hl7/                ./packages/hl7/
COPY packages/core/               ./packages/core/
COPY packages/fhir-router/        ./packages/fhir-router/
COPY packages/bot-layer/          ./packages/bot-layer/
COPY packages/ccda/               ./packages/ccda/
COPY packages/mock/               ./packages/mock/

# Copy server source (will be overridden by volume mount)
COPY packages/server/             ./packages/server/

# Create a Docker-specific config file with correct hostnames
RUN echo '{ \
  "port": 8103, \
  "baseUrl": "http://localhost:8103/", \
  "appBaseUrl": "http://localhost:3000/", \
  "binaryStorage": "file:./binary/", \
  "storageBaseUrl": "http://localhost:8103/storage/", \
  "supportEmail": "\"Medplum\" <support@medplum.com>", \
  "googleClientId": "397236612778-c0b5tnjv98frbo1tfuuha5vkme3cmq4s.apps.googleusercontent.com", \
  "googleClientSecret": "", \
  "recaptchaSiteKey": "6LfHdsYdAAAAAC0uLnnRrDrhcXnziiUwKd8VtLNq", \
  "recaptchaSecretKey": "6LfHdsYdAAAAAH9dN154jbJ3zpQife3xaiTvPChL", \
  "maxJsonSize": "1mb", \
  "maxBatchSize": "50mb", \
  "botLambdaRoleArn": "", \
  "botLambdaLayerName": "medplum-bot-layer", \
  "vmContextBotsEnabled": true, \
  "defaultBotRuntimeVersion": "vmcontext", \
  "allowedOrigins": "*", \
  "introspectionEnabled": true, \
  "database": { \
    "host": "postgres", \
    "port": 5432, \
    "dbname": "medplum", \
    "username": "medplum", \
    "password": "medplum" \
  }, \
  "redis": { \
    "host": "redis", \
    "port": 6379, \
    "password": "medplum" \
  }, \
  "shutdownTimeoutMilliseconds": 30000 \
}' > /app/packages/server/medplum.config.json

# Build all dependency packages that the server needs
# Using turbo's ^... syntax to build only dependencies, not the server itself
# This is faster and handles the dependency order automatically
RUN npx turbo run build --filter=@medplum/server^...

# Create binary directory for file storage
RUN mkdir -p /app/packages/server/binary

# Expose the server port
EXPOSE 8103

# Default command - run server in dev mode with hot reload
CMD ["npm", "run", "dev", "--workspace=@medplum/server"]
